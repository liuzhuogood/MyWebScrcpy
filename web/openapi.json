{
  "openapi": "3.1.0",
  "info": {"title": "MyWebScrcpy API", "version": "1.6.0", "description": "当前服务注册的 HTTP 与 WebSocket 接口。服务默认无内建身份认证，请在受信网络中使用。"},
  "servers": [{"url": "/"}],
  "paths": {
    "/api/devices":{"get":{"tags":["设备与控制"],"summary":"列出在线设备","responses":{"200":{"description":"设备数组"}}}},
    "/api/rotate":{"get":{"tags":["设备与控制"],"summary":"切换设备旋转方向","parameters":[{"$ref":"#/components/parameters/serial"}],"x-side-effect":true,"responses":{"200":{"description":"旋转结果"},"400":{"description":"缺少 serial"}}}},
    "/api/screen-state":{"get":{"tags":["设备与控制"],"summary":"读取屏幕电源状态","parameters":[{"$ref":"#/components/parameters/serial"}],"responses":{"200":{"description":"screenOn"}}}},
    "/api/reboot":{"post":{"tags":["设备与控制"],"summary":"重启设备","parameters":[{"$ref":"#/components/parameters/serial"}],"x-side-effect":true,"responses":{"200":{"description":"成功"},"502":{"description":"ADB 失败"}}}},
    "/ws":{"get":{"tags":["实时投屏"],"summary":"WebSocket 投屏与控制通道","description":"连接后接收二进制视频帧，文本帧用于控制；断开即结束会话。"}},
    "/api/recordings":{"get":{"tags":["录像"],"summary":"列出录像"},"post":{"tags":["录像"],"summary":"开始录像","x-side-effect":true}},
    "/api/recordings/{recording_id}":{"get":{"tags":["录像"],"summary":"读取录像状态"},"delete":{"tags":["录像"],"summary":"删除录像","x-side-effect":true}},
    "/api/recordings/{recording_id}/stop":{"post":{"tags":["录像"],"summary":"停止录像","x-side-effect":true}},
    "/api/recordings/{recording_id}/download":{"get":{"tags":["录像"],"summary":"下载录像"}},
    "/api/recordings/download":{"get":{"tags":["录像"],"summary":"下载最近录像"}},
    "/api/adb/commands":{"post":{"tags":["ADB 与按键"],"summary":"执行 ADB 命令","x-side-effect":true}},
    "/api/adb/commands/{command_id}":{"get":{"tags":["ADB 与按键"],"summary":"读取 ADB 命令状态"}},
    "/api/sendkey":{"post":{"tags":["ADB 与按键"],"summary":"发送按键","x-side-effect":true}},
    "/api/files":{"get":{"tags":["文件"],"summary":"列出设备文件"}},
    "/api/files/download":{"get":{"tags":["文件"],"summary":"下载文件"}},
    "/api/files/upload":{"post":{"tags":["文件"],"summary":"上传文件","x-side-effect":true}},
    "/api/files/folders":{"post":{"tags":["文件"],"summary":"创建文件夹","x-side-effect":true}},
    "/api/files/move":{"post":{"tags":["文件"],"summary":"移动文件","x-side-effect":true}},
    "/api/files/rename":{"post":{"tags":["文件"],"summary":"重命名文件","x-side-effect":true}},
    "/api/files/delete":{"post":{"tags":["文件"],"summary":"删除文件","x-side-effect":true}},
    "/api/files/undo":{"post":{"tags":["文件"],"summary":"撤销文件操作","x-side-effect":true}},
    "/api/scripts/categories":{"get":{"tags":["脚本"],"summary":"列出脚本分类"},"post":{"tags":["脚本"],"summary":"创建脚本分类","x-side-effect":true}},
    "/api/scripts/categories/{cat}":{"patch":{"tags":["脚本"],"summary":"重命名分类","x-side-effect":true},"delete":{"tags":["脚本"],"summary":"删除分类","x-side-effect":true}},
    "/api/scripts":{"get":{"tags":["脚本"],"summary":"列出脚本"}},
    "/api/scripts/{cat}":{"post":{"tags":["脚本"],"summary":"创建脚本","x-side-effect":true}},
    "/api/scripts/{cat}/{name}":{"get":{"tags":["脚本"],"summary":"读取脚本"},"put":{"tags":["脚本"],"summary":"更新脚本","x-side-effect":true},"delete":{"tags":["脚本"],"summary":"删除脚本","x-side-effect":true}},
    "/api/ui/xml":{"get":{"tags":["UI 检查"],"summary":"读取 Android UI XML","parameters":[{"$ref":"#/components/parameters/serial"}]}},
    "/api/vision/stream":{"get":{"tags":["Vision"],"summary":"Vision WebSocket 帧与结果通道"}},
    "/api/vision/results":{"get":{"tags":["Vision"],"summary":"读取 Vision 结果"}},
    "/api/vision/stats":{"get":{"tags":["Vision"],"summary":"读取 Vision 统计"}},
    "/api/vision/debug":{"get":{"tags":["Vision"],"summary":"读取 Vision 调试信息"}}
  },
  "components":{"parameters":{"serial":{"name":"serial","in":"query","required":true,"schema":{"type":"string"},"description":"ADB 设备 serial"}}}
}
