{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyWebScrcpy",
  "version": "1.20.0",
  "identifier": "com.mywebscrcpy.desktop",
  "build": { "frontendDist": "ui" },
  "app": {
    "windows": [],
    "security": { "capabilities": [] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
